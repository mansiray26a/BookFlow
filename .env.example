# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite for local zero-config, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# PostgreSQL Example: DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookflow_db?schema=public"

# Auth Secrets
JWT_SECRET=bookflow_super_secret_jwt_key_2026_academic_lms
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=bookflow_super_secret_refresh_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# CORS Frontend Client URL
FRONTEND_URL=http://localhost:5173

# SMTP Email Notification Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=library@college.edu
SMTP_PASSWORD=app_specific_password
